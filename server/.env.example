# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
PORT=3000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# ---------------------------------------------------------------------------
# Database (matches docker-compose.yml)
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/youtube_analyzer"

# ---------------------------------------------------------------------------
# YouTube Data API v3
# Get a key at https://console.cloud.google.com/apis/credentials
# ---------------------------------------------------------------------------
YOUTUBE_API_KEY=AIzaSyApyIUsmFX772Yj4RwLbEaxajVxs6cfwMs

# ---------------------------------------------------------------------------
# AI provider
#   AI_PROVIDER = heuristic | openai | gemini
#     - heuristic: no API key required, rule-based classification + local
#                  embeddings. Good enough to run the whole app offline.
#     - openai:    needs AI_API_KEY (https://platform.openai.com/api-keys)
#                  suggested AI_MODEL=gpt-4o-mini
#     - gemini:    needs AI_API_KEY (https://aistudio.google.com/app/apikey)
#                  suggested AI_MODEL=gemini-1.5-flash
# ---------------------------------------------------------------------------
AI_PROVIDER=heuristic
AI_API_KEY=
AI_MODEL=

# ---------------------------------------------------------------------------
# Processing limits / tuning
# ---------------------------------------------------------------------------
MAX_COMMENTS_PER_ANALYSIS=2000
AI_CLASSIFY_BATCH_SIZE=50
AI_EMBEDDING_BATCH_SIZE=100

# Clustering (DBSCAN over cosine distance).
# Leave CLUSTER_SIMILARITY_THRESHOLD unset to use the active AI provider's own
# default (heuristic ≈ 0.36, openai/gemini ≈ 0.82). Uncomment to force a value.
# CLUSTER_SIMILARITY_THRESHOLD=0.82
CLUSTER_MIN_POINTS=2

# A video analysed less than this many hours ago is reported as a duplicate
DUPLICATE_ANALYSIS_WINDOW_HOURS=24
